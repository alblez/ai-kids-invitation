---
/**
 * RSVP section — Gael's optional high-five, then the WhatsApp pre-filled message.
 * Below fold: ScrollTrigger reveal.
 */
import reaching from '../assets/rsvp/rsvp-r01w-reaching.webp';
import highFive from '../assets/rsvp/rsvp-r02w-high-five.webp';

// Fictional placeholder: replace with your WhatsApp number (country code, no +)
const whatsappNumber: string = '15555550123';
const whatsappMessage: string = encodeURIComponent(
  "Hi! We'll be at Gael's party. See you there!"
);
const whatsappUrl: string = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;
---

<section
  id="rsvp"
  class="relative py-20 px-4 md:px-8 max-w-2xl mx-auto text-center overflow-x-clip"
>
  <p class="rsvp-callout font-display text-2xl md:text-3xl text-star-yellow mb-2">
    Hope you can come!
  </p>

  <h2 class="rsvp-title font-display text-4xl md:text-5xl text-power-red mb-4">
    Gael says, come play!
  </h2>

  <!-- R01 is plain HTML; R02, the effects and the button need the script and both decoded images -->
  <div class="rsvp-frame relative mx-auto w-80 md:w-96 aspect-5/6">
    <div class="rsvp-figure size-full">
      <img
        class="rsvp-pose size-full"
        src={reaching.src}
        width={reaching.width}
        height={reaching.height}
        loading="lazy"
        decoding="async"
        alt="Gael in a red and blue superhero suit, mask off, raising his open hand for a high five"
      />
      <img
        class="rsvp-pose absolute inset-0 size-full"
        src={highFive.src}
        width={highFive.width}
        height={highFive.height}
        loading="lazy"
        decoding="async"
        alt=""
        hidden
      />
    </div>
    <!-- Fixed effect pool (25 nodes), reused by every tap -->
    <div class="rsvp-burst absolute inset-0 pointer-events-none" aria-hidden="true">
      {Array.from({ length: 6 }, () => <span class="rsvp-line" />)}
      {Array.from({ length: 2 }, () => <span class="rsvp-ring" />)}
      {Array.from({ length: 12 }, (_, i) => (
        <span class:list={['rsvp-bit', i % 2 && 'rsvp-star', ['bg-power-blue', 'bg-power-green', 'bg-power-red'][i % 3]]} />
      ))}
      <span class="rsvp-spider">
        <svg viewBox="0 0 40 40">
          <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M20 17 12 8 10 2M20 17l8-9 2-6M19 19 9 15l-6 2M21 19l10-4 6 2M19 22 9 25l-5 6M21 22l10 3 5 6M19 24l-6 8-1 6M21 24l6 8 1 6" />
          <path fill="currentColor" d="M20 11a3 3 0 1 1 0 6 3 3 0 1 1 0-6ZM20 17c3 0 4.5 3.5 4.5 7s-2 9-4.5 9-4.5-5.5-4.5-9 1.5-7 4.5-7Z" />
        </svg>
      </span>
      <span class="rsvp-word font-display"></span>
    </div>
    <!-- Speech bubble: empty (invisible) until the first high-five; the only live region -->
    <p class="rsvp-caption font-display text-base md:text-xl" aria-live="polite"></p>
  </div>

  <!-- Reserved slot right under Gael's hand: showing the button never moves the WhatsApp link -->
  <div class="min-h-14">
    <button
      type="button"
      class="rsvp-high-five inline-flex items-center min-h-12 px-8 rounded-full bg-star-yellow text-night-sky font-display text-2xl tracking-wide shadow-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      hidden
    >
      High five!
    </button>
  </div>

  <p class="rsvp-text text-white/70 text-lg mt-6 mb-8 max-w-md mx-auto">
    There's a high five waiting for you! Ask a grown-up to tell us on WhatsApp if you'll be at the party.
  </p>
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="rsvp-link inline-flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-lg py-4 px-8 rounded-2xl transition-[scale,background-color] hover:scale-105 active:scale-95 shadow-lg shadow-[#25D366]/30"
  >
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z" />
    </svg>
    RSVP on WhatsApp
  </a>

  <p class="mt-12 text-white/30 text-sm font-display">
    Made with ❤️ for Gael
  </p>
</section>

<style>
  /* Frame and figure squash/lean around Gael's feet */
  .rsvp-frame,
  .rsvp-figure {
    transform-origin: 50% 96%;
  }
  /* Pool nodes start at the R01 palm centre (338, 482) of the 1000x1200 canvas */
  .rsvp-burst > * {
    position: absolute;
    left: 33.8%;
    top: 40.2%;
    translate: -50% -50%;
    visibility: hidden;
  }
  .rsvp-burst > .rsvp-line {
    width: 120px;
    height: 3px;
    translate: 0 -50%;
    transform-origin: 0 50%;
    border-radius: 2px;
    background: var(--color-web-white);
    box-shadow: 0 0 4px rgb(248 250 252 / 0.8);
  }
  /* Half ring open towards the face (upper right): only the left and bottom borders */
  .rsvp-ring {
    width: 64px;
    height: 64px;
    border: 5px solid;
    border-color: transparent transparent currentColor currentColor;
    border-radius: 50%;
    color: var(--color-web-white);
  }
  .rsvp-bit {
    width: 9px;
    height: 16px;
    border-radius: 2px;
  }
  .rsvp-star {
    width: 18px;
    height: 18px;
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }
  .rsvp-spider {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 3px solid var(--color-web-white);
    border-radius: 50%;
    background: var(--color-hero-red);
    color: #111;
  }
  .rsvp-spider svg {
    width: 70%;
  }
  /* Onomatopoeia: halftone starburst behind the word, in the empty corner up-left of the hand */
  .rsvp-burst > .rsvp-word {
    left: 16%;
    top: 16%;
    display: grid;
    place-items: center;
    width: 104px;
    height: 84px;
    isolation: isolate;
    font-size: 28px;
    text-shadow: 2px 2px 0 var(--color-night-sky);
    transform-origin: 80% 90%;
  }
  .rsvp-word::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle, rgb(15 23 42 / 0.2) 1.5px, transparent 2px) 0 0 / 7px 7px, var(--bg);
    clip-path: polygon(50% 0%, 58% 13%, 72% 5%, 74% 20%, 89% 19%, 84% 34%, 99% 39%, 88% 50%, 99% 61%, 84% 66%, 89% 81%, 74% 80%, 72% 95%, 58% 87%, 50% 100%, 42% 87%, 28% 95%, 26% 80%, 11% 81%, 16% 66%, 1% 61%, 12% 50%, 1% 39%, 16% 34%, 11% 19%, 26% 20%, 28% 5%, 42% 13%);
  }
  @media (width >= 48rem) {
    .rsvp-burst > .rsvp-word {
      width: 124px;
      height: 100px;
      font-size: 34px;
    }
  }
  /* Comic speech bubble beside the hair (never on the face); tail points to the mouth */
  .rsvp-caption {
    position: absolute;
    left: 66%;
    top: 0;
    width: 40%;
    padding: 0.45em 0.6em;
    border-radius: 1em;
    background: var(--color-web-white);
    color: var(--color-night-sky);
    line-height: 1.1;
    box-shadow: 3px 3px 0 var(--color-star-yellow);
    transform-origin: 0 100%;
  }
  .rsvp-caption::after {
    content: '';
    position: absolute;
    left: 6px;
    bottom: -14px;
    width: 18px;
    height: 16px;
    background: inherit;
    clip-path: polygon(40% 0, 100% 0, 0 100%);
  }
  /* opacity, not visibility: the live region stays in the accessibility tree while empty */
  .rsvp-caption:empty {
    opacity: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  // Essential content is not .gsap-hidden: GSAP hides it only once this module runs.
  const ESSENTIAL = '.rsvp-callout, .rsvp-title, .rsvp-text, .rsvp-link';
  let reveal: ReturnType<typeof gsap.fromTo> | undefined;
  try {
    if (!reduce.matches) {
      reveal = gsap.fromTo(ESSENTIAL, { autoAlpha: 0, y: 20 }, {
        autoAlpha: 1,
        y: 0,
        duration: 0.5,
        stagger: 0.1,
        scrollTrigger: { trigger: '.rsvp-callout', start: 'top 90%' },
      });
      // Reduced motion switched on: show everything now. (gsap.matchMedia would refresh
      // ScrollTrigger on every change, which smooth-scrolls the page to the top.)
      reduce.addEventListener('change', () => reveal?.revert(), { once: true });
    }
  } catch {
    reveal?.revert(); // also kills its ScrollTrigger, which would re-apply the hidden from-state
    document.querySelectorAll(ESSENTIAL).forEach((el) => el.removeAttribute('style'));
  }

  // Any failure leaves the button hidden; R01, copy and WhatsApp are unaffected.
  try {
    setupHighFive();
  } catch { /* essential content is unaffected */ }

  function setupHighFive() {
    const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
    const $$ = (s: string) => [...document.querySelectorAll<HTMLElement>(s)];
    const [r01, r02] = document.querySelectorAll<HTMLImageElement>('.rsvp-pose');
    const button = $<HTMLButtonElement>('.rsvp-high-five');
    const [frame, figure, caption, link, word, spider] = [
      '.rsvp-frame', '.rsvp-figure', '.rsvp-caption', '.rsvp-link', '.rsvp-word', '.rsvp-spider',
    ].map((s) => $(s));
    const [rings, bits, lines] = [$$('.rsvp-ring'), $$('.rsvp-bit'), $$('.rsvp-line')];
    const stars = bits.filter((_, i) => i % 2);
    const pool = [word, spider, ...rings, ...bits, ...lines];
    // Tap n shows caption and scene n, then loops from #2.
    const CAPTIONS = [
      'Nice one, hero!', 'Whoa, that was a big one!', 'Your hero power is on!', 'A web just shot out!',
      'Oops, sticky hand!', 'Even baddies felt it!', 'New high-five record!',
      'Coming? RSVP on WhatsApp.',
    ];
    const [YELLOW, RED, BLUE, GREEN, WHITE] = ['#fbbf24', '#ef4444', '#3b82f6', '#22c55e', '#f8fafc'];
    const HIT = 0.22; // contact: R01 -> R02 after the anticipation lean
    let tl = gsap.timeline();
    let taps = 0;
    let k = 1; // effect distances are designed for the 320 px mobile frame

    const rad = (deg: number) => (deg * Math.PI) / 180;
    // Safe fan from down-right (60deg) through left to up-left (250deg): never towards the face (up-right)
    const fan = (i: number, n: number) => 60 + (i * 190) / (n - 1);
    const fanX = (n: number, d: (i: number) => number) => (i: number) => Math.cos(rad(fan(i, n))) * d(i) * k;
    const fanY = (n: number, d: (i: number) => number) => (i: number) => Math.sin(rad(fan(i, n))) * d(i) * k;
    const show = { autoAlpha: 1, x: 0, y: 0 };

    function pose(after: boolean) {
      r02.hidden = !after;
      r01.style.opacity = after ? '0' : ''; // stays in the accessibility tree
    }

    function reset() {
      tl.kill();
      gsap.set(pool, { clearProps: 'transform,opacity,visibility,background-color' });
      gsap.set([frame, figure, caption, button, link], { clearProps: 'transform' });
    }

    function settle() {
      reset();
      pose(taps > 0);
    }

    // Onomatopoeia burst up-left of the hand
    function pop(text: string, bg: string, fg: string, size = 1) {
      word.textContent = text;
      word.style.setProperty('--bg', bg);
      word.style.color = fg;
      tl.fromTo(word, { ...show, scale: 0, rotation: -25 }, {
        scale: size, rotation: -8, duration: 0.35, ease: 'back.out(2.5)', immediateRender: false,
      }, HIT)
        .to(word, { rotation: -4, duration: 0.06, yoyo: true, repeat: 3 }, HIT + 0.4)
        .to(word, { scale: size * 1.2, autoAlpha: 0, duration: 0.2, ease: 'power1.in' }, HIT + 0.95);
    }

    function shockwave(color: string, to = 3) {
      rings.forEach((r) => { r.style.color = color; });
      tl.fromTo(rings, { ...show, scale: 0.3 }, {
        scale: to, autoAlpha: 0, duration: 0.75, ease: 'power2.out', stagger: 0.15, immediateRender: false,
      }, HIT);
    }

    const SCENES: Array<() => void> = [
      // 1. POW! + six stars fanning out
      () => {
        pop('POW!', YELLOW, RED);
        tl.fromTo(stars, { ...show, scale: 0.4, rotation: 0 }, {
          x: fanX(6, (i) => 70 + (i % 3) * 15), y: fanY(6, (i) => 70 + (i % 3) * 15),
          scale: 1.2, rotation: 240, duration: 0.7, ease: 'power2.out', immediateRender: false,
        }, HIT).to(stars, { autoAlpha: 0, duration: 0.25 }, HIT + 0.85);
      },
      // 2. ZAP! + squash-and-stretch + shockwave
      () => {
        pop('ZAP!', BLUE, WHITE);
        shockwave(WHITE);
        tl.to(frame, { scaleX: 1.08, scaleY: 0.92, duration: 0.1, ease: 'power2.out' }, HIT)
          .to(frame, { scaleX: 1, scaleY: 1, duration: 0.8, ease: 'elastic.out(1.2, 0.3)' }, HIT + 0.1);
      },
      // 3. Hero sense: emblem spins out of the palm, dashes flicker, emblem floats away
      () => {
        const [sx, sy] = [-62 * k, -70 * k];
        tl.fromTo(spider, { ...show, scale: 0, rotation: -180 }, {
          x: sx, y: sy, scale: 1.1, rotation: 0, duration: 0.5, ease: 'back.out(2)', immediateRender: false,
        }, HIT)
          .fromTo(lines, {
            autoAlpha: 0,
            rotation: (i: number) => i * 60,
            x: (i: number) => sx + Math.cos(rad(i * 60)) * 40 * k,
            y: (i: number) => sy + Math.sin(rad(i * 60)) * 40 * k,
            scaleX: 0.15,
          }, { autoAlpha: 1, duration: 0.12, repeat: 3, yoyo: true, ease: 'none', immediateRender: false }, HIT + 0.4)
          .to(spider, { y: sy - 40 * k, autoAlpha: 0, duration: 0.45, ease: 'power1.in' }, HIT + 1);
      },
      // 4. THWIP! + six web strands
      () => {
        pop('THWIP!', WHITE, RED);
        tl.fromTo(lines, { ...show, rotation: (i: number) => fan(i, 6), scaleX: 0 }, {
          scaleX: (i: number) => (0.7 + (i % 3) * 0.2) * k,
          duration: 0.18, stagger: 0.04, ease: 'power3.out', immediateRender: false,
        }, HIT)
          .to(lines, { autoAlpha: 0, duration: 0.3 }, HIT + 0.9)
          .fromTo(rings[0], { ...show, scale: 0.3 }, {
            scale: 2, autoAlpha: 0, duration: 0.6, ease: 'power2.out', immediateRender: false,
          }, HIT);
      },
      // 5. SPLAT! + sticky confetti that snaps back + jelly wobble
      () => {
        pop('SPLAT!', GREEN, WHITE);
        tl.fromTo(bits, { ...show, scale: 0.5, rotation: 0 }, {
          x: fanX(12, (i) => 50 + (i % 3) * 12), y: fanY(12, (i) => 50 + (i % 3) * 12),
          scale: 1.2, rotation: 120, duration: 0.35, ease: 'power2.out',
          yoyo: true, repeat: 1, repeatDelay: 0.15, immediateRender: false,
        }, HIT)
          .to(bits, { autoAlpha: 0, duration: 0.1 }, HIT + 0.85)
          .fromTo(frame, { rotation: 4 }, {
            rotation: 0, duration: 1.1, ease: 'elastic.out(1.5, 0.2)', immediateRender: false,
          }, HIT);
      },
      // 6. BOOM! + earthquake + red shockwave
      () => {
        pop('BOOM!', RED, YELLOW, 1.1);
        shockwave(RED);
        tl.fromTo(frame, { x: -8 }, {
          x: 8, duration: 0.04, repeat: 9, yoyo: true, ease: 'none', immediateRender: false,
        }, HIT).to(frame, { x: 0, duration: 0.05 }, HIT + 0.4);
      },
      // 7. Record: running count + confetti fountain
      () => {
        pop(`x${taps}`, BLUE, YELLOW);
        tl.fromTo(bits, { ...show, scale: 0.6, rotation: 0 }, {
          x: (i: number) => -(25 + i * 9) * k,
          y: (i: number) => -(60 + ((i * 7) % 12) * 8) * k,
          scale: 1.2, rotation: 200, duration: 0.45, ease: 'power2.out', immediateRender: false,
        }, HIT)
          .to(bits, { y: `+=${220 * k}`, rotation: '+=240', duration: 0.8, ease: 'power2.in', stagger: 0.02 }, HIT + 0.45)
          .to(bits, { autoAlpha: 0, duration: 0.2 }, HIT + 1.2);
      },
      // 8. Stars point down to WhatsApp, which gets a short nudge (transform only)
      () => {
        tl.fromTo(stars, { ...show, scale: 0.5, backgroundColor: YELLOW }, {
          x: (i: number) => -(20 + i * 12) * k, y: -40 * k, scale: 1.3,
          duration: 0.3, ease: 'power2.out', immediateRender: false,
        }, HIT)
          .to(stars, {
            x: (i: number) => (30 + i * 8) * k, y: 260 * k, rotation: 360, autoAlpha: 0,
            duration: 0.8, ease: 'power1.in', stagger: 0.04,
          }, HIT + 0.3)
          .to(link, { scale: 1.06, rotation: 2, duration: 0.15, ease: 'sine.out' }, HIT + 0.6)
          .to(link, { rotation: -2, duration: 0.15, yoyo: true, repeat: 1, ease: 'sine.inOut' }, '>')
          .to(link, { scale: 1, rotation: 0, duration: 0.15 }, '>');
      },
    ];

    function highFive() {
      const i = taps < CAPTIONS.length ? taps : 1 + ((taps - 1) % (CAPTIONS.length - 1));
      taps++;
      caption.textContent = CAPTIONS[i];
      if (reduce.matches) return settle();
      reset(); // latest tap wins
      pose(false);
      k = frame.offsetWidth / 320;
      tl = gsap.timeline()
        .to(button, { scale: 0.96, duration: 0.08, yoyo: true, repeat: 1 }, 0)
        .to(figure, { scale: 1.06, rotation: -3, duration: HIT, ease: 'power2.in' }, 0) // anticipation
        .call(() => pose(true), undefined, HIT)
        .to(figure, { scale: 1, rotation: 0, duration: 0.6, ease: 'elastic.out(1, 0.4)' }, HIT)
        .fromTo(caption, { scale: 0, rotation: -8 }, { scale: 1, rotation: 0, duration: 0.35, ease: 'back.out(2)' }, HIT);
      SCENES[i]();
    }

    function fail(img: HTMLImageElement) {
      img.style.visibility = 'hidden'; // no broken icon; the frame keeps its space
      settle();
      button.hidden = true;
      r02.hidden = true;
    }

    button.addEventListener('click', highFive);
    reduce.addEventListener('change', settle);
    [r01, r02].forEach((img) => img.addEventListener('error', () => fail(img)));

    // Start loading one viewport before RSVP; the hidden lazy R02 would never load on its own.
    ScrollTrigger.create({
      trigger: '#rsvp',
      start: () => `top bottom+=${innerHeight}`,
      end: 'max',
      once: true,
      onEnter: () => {
        r01.loading = r02.loading = 'eager';
        Promise.all([r01.decode(), r02.decode()]).then(
          () => { button.hidden = false; },
          () => [r01, r02].forEach((img) => img.complete && !img.naturalWidth && fail(img)),
        );
      },
    });
  }
</script>
